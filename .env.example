# Copy this file to .env. Never commit the real .env file.
AUTOFISH_ENVIRONMENT=production
POSTGRES_DB=autofish
POSTGRES_USER=autofish
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Bounded SQLAlchemy pool and PostgreSQL session guards. The idle transaction
# timeout is deliberately longer than the 960-second Celery hard task limit.
AUTOFISH_DATABASE_POOL_SIZE=10
AUTOFISH_DATABASE_MAX_OVERFLOW=10
AUTOFISH_DATABASE_POOL_TIMEOUT_SECONDS=30
AUTOFISH_DATABASE_POOL_RECYCLE_SECONDS=1800
AUTOFISH_DATABASE_STATEMENT_TIMEOUT_MS=120000
AUTOFISH_DATABASE_LOCK_TIMEOUT_MS=5000
AUTOFISH_DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=1020000
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional dedicated key for encrypting model API credentials. Falls back to JWT_SECRET.
AUTOFISH_CREDENTIAL_ENCRYPTION_SECRET=
AUTOFISH_ADMIN_USERNAME=admin
AUTOFISH_ADMIN_PASSWORD=replace-with-a-strong-admin-password
AUTOFISH_CORS_ORIGINS=http://localhost:18180,http://192.168.199.180:18180
AUTOFISH_SEED_DEMO=false
AUTOFISH_LOG_LEVEL=INFO
AUTOFISH_ADAPTERS_ENABLED=false
AUTOFISH_ADAPTER_WRITE_ENABLED=false
# disabled | json_gateway | shopkeeper_cli | product_find_cli | hybrid_cli
AUTOFISH_SUPPLIER_ADAPTER=disabled
AUTOFISH_SUPPLIER_GATEWAY_URL=
AUTOFISH_SUPPLIER_GATEWAY_TOKEN=
# Development fallback only. Production uses the read-only mounted file below.
AUTOFISH_SUPPLIER_ACCESS_KEY=
AUTOFISH_SUPPLIER_ACCESS_KEY_FILE=/run/autofish-credentials/1688-api-key
AUTOFISH_SUPPLIER_CLI_COMMAND=
AUTOFISH_SUPPLIER_SHOPKEEPER_CLI_COMMAND=
AUTOFISH_SUPPLIER_PRODUCT_FIND_CLI_COMMAND=
AUTOFISH_SUPPLIER_CLI_TIMEOUT_SECONDS=60
# disabled | json_gateway | goofish_cli | top_api
AUTOFISH_XIANYU_ADAPTER=disabled
AUTOFISH_XIANYU_GATEWAY_URL=
AUTOFISH_XIANYU_GATEWAY_TOKEN=
AUTOFISH_XIANYU_CLI_COMMAND=
AUTOFISH_XIANYU_COOKIE_PATH=/run/autofish-credentials/goofish-cookies.json
AUTOFISH_XIANYU_CLI_TIMEOUT_SECONDS=60
AUTOFISH_XIANYU_TOP_APP_KEY=
# Development fallback only. Production mounts the two secret files below.
AUTOFISH_XIANYU_TOP_APP_SECRET=
AUTOFISH_XIANYU_TOP_APP_SECRET_FILE=/run/autofish-credentials/xianyu-top-app-secret
AUTOFISH_XIANYU_TOP_SESSION=
AUTOFISH_XIANYU_TOP_SESSION_FILE=/run/autofish-credentials/xianyu-top-session
AUTOFISH_XIANYU_TOP_ENDPOINT=https://eco.taobao.com/router/rest
AUTOFISH_XIANYU_WEBHOOK_TOKEN_FILE=/run/autofish-credentials/xianyu-webhook-token
# Dedicated token used only by the local Chrome bridge. Generate at least 32 random bytes.
AUTOFISH_XIANYU_BROWSER_BRIDGE_TOKEN_FILE=/run/autofish-credentials/xianyu-browser-bridge-token
# Allows the local Chrome bridge to click the final Xianyu publish button.
# The GLOBAL and PUBLISH controls must also be enabled and PUBLISH must use
# AUTOMATIC mode before the scheduler can create unattended publish tasks.
AUTOFISH_XIANYU_BROWSER_PUBLISH_ENABLED=false
# Allows unattended browser conversation capture and guarded AI replies. This
# is independent from publishing and remains off by default. GLOBAL and
# CUSTOMER_SERVICE must also be enabled, with CUSTOMER_SERVICE in AUTOMATIC mode.
AUTOFISH_XIANYU_BROWSER_CUSTOMER_SERVICE_ENABLED=false

# Scheduler remains off until adapter health and a reviewed canary action pass.
AUTOFISH_AUTOMATION_SCHEDULER_ENABLED=false
AUTOFISH_AUTOMATION_MESSAGE_INTERVAL_SECONDS=120
AUTOFISH_AUTOMATION_ORDER_INTERVAL_SECONDS=180
AUTOFISH_AUTOMATION_SUPPLIER_INTERVAL_SECONDS=900
AUTOFISH_AUTOMATION_PUBLISH_INTERVAL_SECONDS=300
AUTOFISH_AUTOMATION_SCHEDULER_BATCH_SIZE=50
AUTOFISH_ASSET_ROOT=/app/assets
AUTOFISH_LOGIN_MAX_ATTEMPTS=5
AUTOFISH_LOGIN_WINDOW_SECONDS=900
AUTOFISH_BACKUP_INTERVAL_SECONDS=86400
AUTOFISH_BACKUP_RETENTION_DAYS=14
AUTOFISH_BACKUP_MAX_AGE_MINUTES=1560
